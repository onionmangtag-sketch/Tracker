rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json','upd','tz','sent'])
        && request.resource.data.json is string && request.resource.data.json.size() < 500000
        && request.resource.data.tz is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
      match /devices/{device} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token','updated']);
      }
    }
  }
}
